{
  "name": "syncro-esg-backend",
  "version": "1.0.0",
  "description": "API do Syncro ESG",
  "scripts": {
    "build": "nest build",
    "start": "node dist/main",
    "start:dev": "nest start --watch",
    "db:setup": "node --env-file-if-exists=.env scripts/setup-db.mjs",
    "db:reset": "node --env-file-if-exists=.env scripts/setup-db.mjs --reset",
    "db:seed": "node --env-file-if-exists=.env scripts/seed-demo.mjs"
  },
  "type": "commonjs",
  "dependencies": {
    "@nestjs/common": "^11.2.8",
    "@nestjs/core": "^11.2.8",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/platform-express": "^11.2.8",
    "bcryptjs": "^3.0.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "pg": "^8.23.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.24",
    "@types/node": "^26.6.5",
    "@types/pg": "^8.23.1",
    "typescript": "^5.9.3"
  },
  "private": true
}
